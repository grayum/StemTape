# Copy to .env beside docker-compose.yaml. Keep the real .env out of Git.
# Official Alpine Nginx image: version tag is convenient for local testing.
# For production replace with nginx@sha256:... from your verified image pull.
NGINX_IMAGE=nginx:1.30.5-alpine

# Local image built by Compose; use a release digest when promoting to production.
STEMTAPE_IMAGE=stemtape:0.4.1

# Only used when you enable the commented Traefik sections:
STEMTAPE_DOMAIN=stemtape.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=myresolver
